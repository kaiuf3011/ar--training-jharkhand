# Copy to .env and fill in real values. Never commit the real .env.

ENV=development

# Local dev default (SQLite, zero setup). For docker-compose / anything
# resembling production, point this at Postgres instead:
# DATABASE_URL=postgresql+psycopg://jsar:jsar@localhost:5432/jharkhand_safety_ar
DATABASE_URL=sqlite:///./dev.db

# REQUIRED outside ENV=development — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated is NOT supported by pydantic-settings' list parsing here;
# set as a JSON array, e.g. ["https://admin.example.com"]
CORS_ORIGINS=["*"]

# Base URL embedded in certificate QR codes as /verify/{certificate_number}
PUBLIC_BASE_URL=http://localhost:8000

RATE_LIMIT_PER_MINUTE=120
